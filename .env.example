# Copy to .env and fill in. Never commit .env.

# localStorage "bhopp.token" on bhopp.com. Lasts 7 days; the bot warns before it runs out.
BHOPP_TOKEN=

# discord.com/developers -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Channel the alerts go to (right click the channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Your Discord user ID: who gets pinged, and the only person who can use the commands
DISCORD_OWNER_ID=
# Optional: your server ID, so the commands appear instantly
DISCORD_GUILD_ID=

# Seconds between checks for new sales
POLL_INTERVAL_SECONDS=15
# true = never write to BHOPP: messages and cancels are shown in Discord instead
DRY_RUN=false
